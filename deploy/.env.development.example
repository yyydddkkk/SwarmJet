# Copy to deploy/.env.development; deploy/.env keeps credentials and DATA_DIR.
# Shell environment takes precedence over dotenv files (Vite loadEnv semantics).
# The scripts/dev wrapper needs Go on PATH, or GO_BINARY in the shell command.
# This value is also used when recompiling the backend:
# GO_BINARY=/home/you/.local/share/go/bin/go
# META_COMMAND=/home/you/.local/bin/meta
DEV_WEB_PORT=5273
DEV_API_PORT=8181
# To register a Node on another LAN host, bind the native API to this host's private IPv4 and restart scripts/dev.
# DEV_API_HOST=10.0.0.20
DEV_RUNTIME_PORT=8191
# On Linux the launcher resolves postgres/temporal from the existing Compose
# bridge on every start. Explicit external/native addresses can override this:
# DATABASE_URL=postgres://swarmjet:password@127.0.0.1:15432/swarmjet?sslmode=disable
# TEMPORAL_ADDRESS=127.0.0.1:7233
