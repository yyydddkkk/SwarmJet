# syntax=docker/dockerfile:1
# Node 22 also supports business repositories whose engines exclude Node 23+.
ARG AGENT_BASE_IMAGE=node:22.23.1-bookworm-slim
FROM ${AGENT_BASE_IMAGE}
# oh-my-pi is installed from its locked, prebuilt release and verified against
# the published SHA-256 values before it is placed on PATH.
ARG OMP_VERSION=18.12.2
ARG OMP_SHA256_X64=9513ef9f19d7991aac6ae0cb6077bcf16662092ddde861c002a91cedc6f47f9a
ARG OMP_SHA256_ARM64=967d64fce514586e94c9ac5f978743b4fce29b999c8763747ce4754811407d1a
ARG CODEX_VERSION=0.155.1
ARG CLAUDE_VERSION=2.1.278
# Exact-session resume and --json require this published prerelease.
ARG DSH_VERSION=0.1.6-alpha.2
ARG DST_VERSION=0.10.2
ARG AGENT_CLIS=
ARG GLAB_VERSION=1.115.0
ARG UV_VERSION=0.8.22
ARG PNPM_VERSION=10.17.1
ARG EXTRA_APT_PACKAGES=
ARG TARGETARCH
ARG NPM_REGISTRY=https://registry.npmjs.org
ARG PYPI_INDEX=https://pypi.org/simple
ARG GLAB_RELEASE_URL=https://gitlab.com/gitlab-org/cli/-/releases
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git jq ripgrep python3 python3-pip python3-venv build-essential pkg-config libpq-dev openssh-client procps ${EXTRA_APT_PACKAGES} \
 && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages --index-url "${PYPI_INDEX}" "uv==${UV_VERSION}" \
 && npm install --global --registry "${NPM_REGISTRY}" "pnpm@${PNPM_VERSION}" \
 && uv --version && pnpm --version
RUN set -eu; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64) asset="omp-linux-x64"; sum="${OMP_SHA256_X64}" ;; \
      arm64) asset="omp-linux-arm64"; sum="${OMP_SHA256_ARM64}" ;; \
      *) echo "Unsupported architecture for oh-my-pi: ${arch}" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    curl -fsSL -o "$asset" "https://github.com/can1357/oh-my-pi/releases/download/v${OMP_VERSION}/${asset}"; \
    printf '%s  %s\n' "$sum" "$asset" | sha256sum -c -; \
    install -m 0755 "$asset" /usr/local/bin/omp; \
    rm -f "$asset"; \
    omp --version
RUN set -eu; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    archive="glab_${GLAB_VERSION}_linux_${arch}.tar.gz"; \
    cd /tmp; \
    curl -fsSL -o "$archive" "${GLAB_RELEASE_URL}/v${GLAB_VERSION}/downloads/${archive}"; \
    curl -fsSL -o checksums.txt "${GLAB_RELEASE_URL}/v${GLAB_VERSION}/downloads/checksums.txt"; \
    grep " ${archive}$" checksums.txt | sha256sum -c -; \
    tar -xzf "$archive"; \
    install -m 0755 bin/glab /usr/local/bin/glab; \
    rm -rf "$archive" checksums.txt bin; \
    glab --version
COPY scripts/install-agent-clis.sh /tmp/install-agent-clis.sh
RUN bash /tmp/install-agent-clis.sh && rm /tmp/install-agent-clis.sh
COPY scripts/askpass.sh /usr/local/bin/swarmjet-askpass
RUN chmod 0755 /usr/local/bin/swarmjet-askpass
ENV GIT_TERMINAL_PROMPT=0 ELECTRON_SKIP_BINARY_DOWNLOAD=1
WORKDIR /workspace
# The supervisor supplies container identity, mounts, permissions, environment and argv.
ENTRYPOINT ["/bin/bash"]
CMD ["--noprofile", "--norc"]
