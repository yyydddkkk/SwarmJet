# Copy to deploy/.env, chmod 0600.
# Generate independent values: openssl rand -hex 24. Never commit .env.
COMPOSE_PROJECT_NAME=swarmjet
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgres://swarmjet:replace-with-a-random-hex-password@postgres:5432/swarmjet?sslmode=disable
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-an-independent-random-password
# Absolute existing path, identical on host and inside worker/agent containers.
DATA_DIR=/srv/swarmjet/data
IMAGE=swarmjet:local
AGENT_IMAGE=swarmjet-agent:local
PUBLIC_ORIGIN=http://localhost:8180
LISTEN_HOST=127.0.0.1
HTTP_PORT=8180
SECURE_COOKIES=false
TEMPORAL_NAMESPACE=swarmjet
TEMPORAL_UI_PORT=8333
TEMPORAL_UI_ORIGIN=http://localhost:8333
TASK_CONCURRENCY=2
# Cancelled-task artifacts / completed-task reports; active/blocked tasks are retained.
FAILED_KEEP_DAYS=7
REPORT_KEEP_DAYS=30
# Explicit test-container variables; also inject their values via compose.override.yaml.
INTEGRATION_ENV_ALLOWLIST=

# Project forms store these environment-variable NAMES, never token values.
# Development token: issue/MR API and repository push; no protected-target merge.
# Merge token: separate bot identity allowed to merge protected target branches.
GITLAB_TOKEN=
GITLAB_MERGE_TOKEN=
GITLAB_WEBHOOK_SECRET=
# Include only model/config variables agents actually need. No ADMIN/DATABASE keys.
AGENT_ENV_ALLOWLIST=OPENAI_API_KEY,CODEX_API_KEY,ANTHROPIC_API_KEY,CLAUDE_CODE_OAUTH_TOKEN,DEEPSEEK_API_KEY,GEMINI_API_KEY,AGY_ADC_AUTH,GOOGLE_GEMINI_BASE_URL,OPENCODE_CONFIG_CONTENT
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional OpenCode JSON configuration; prefer {env:VARIABLE_NAME} credential refs.
OPENCODE_CONFIG_CONTENT=
GIT_AUTHOR_NAME=swarmjet
GIT_AUTHOR_EMAIL=swarmjet@example.invalid

# Private API-to-Worker runtime management. Generate with: openssl rand -hex 32
# Leave empty to disable the configuration terminal. Never expose container Worker port 8091.
RUNTIME_ADMIN_SECRET=

# Encrypts saved GitLab connection tokens at rest. Generate once with:
#   openssl rand -hex 32
# This key must stay stable and be backed up separately from the database: if it
# changes or is lost, previously saved connection tokens cannot be decrypted and
# must be re-entered. Leave empty to disable browser-entered connections; projects
# using GITLAB_TOKEN / GITLAB_MERGE_TOKEN keep working.
SWARMJET_MASTER_KEY=

# Image used to run initialization verification commands in an isolated
# container (no network, read-only root, all capabilities dropped). Use an image
# that contains the project's toolchain, often a derived agent image. When empty,
# verification is blocked: model-generated commands never run as the worker
# process, and the project cannot be enabled or accept tasks until it verifies.
INIT_VERIFY_IMAGE=
# Execution nodes. Generate NODE_SECRET with: openssl rand -hex 32
# local = assigned work falls back to the control-plane Worker (single host).
# distributed = every new task must be assigned to a registered node.
EXECUTION_MODE=local
NODE_SECRET=
# Node-only settings, used by compose.node.yaml on an execution host.
NODE_ID=node-1
NODE_DATA_DIR=/srv/swarmjet/node-data
NODE_ADVERTISE_URL=http://node-host:8092
CONTROL_PLANE_URL=http://control-plane:8180
NODE_CAPACITY=2

# CLI packages to include when building the agent image (not platform enablement).
# Choices: opencode,codex,dst,agy,claude. Managed initialization needs opencode.
AGENT_CLIS=opencode
CODEX_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
GEMINI_API_KEY=
AGY_ADC_AUTH=
GOOGLE_GEMINI_BASE_URL=

# Dedicated BuildKit/Distribution deployment: compose.builder.yaml.
# Each execution node can use a different versioned network profile in the UI.
# Docker daemon registry proxy / CA trust remain host deployment settings.
# The installer writes generated LAN registry credentials and TLS paths to deploy/.env.registry.
LOCAL_NODE_ID=local
