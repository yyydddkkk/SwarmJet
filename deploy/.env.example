# Copy to deploy/.env, then `chmod 600 .env`. Never commit .env.
# `deploy/install.py` generates all of these values for you.
COMPOSE_PROJECT_NAME=swarmjet

# --- Required -------------------------------------------------------------
# Generate independent random values: openssl rand -hex 24.
POSTGRES_PASSWORD=replace-with-a-random-hex-password
DATABASE_URL=postgres://swarmjet:replace-with-a-random-hex-password@postgres:5432/swarmjet?sslmode=disable
# The single administrator account. Password must be at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-an-independent-random-password
# 32 random bytes as hex (openssl rand -hex 32). Encrypts GitHub App
# credentials in the database; back it up and never rotate it casually.
SWARMJET_MASTER_KEY=replace-with-64-hex-characters
# Absolute host path. The same path is mounted inside the api container.
DATA_DIR=/srv/swarmjet/data

# --- Images ---------------------------------------------------------------
# Use the published images (install.py chooses a version tag) or local tags
# built with compose.build.yaml.
IMAGE=swarmjet:local
AGENT_IMAGE=swarmjet-agent:local
# Locked oh-my-pi release. The Agent image and the auth broker/gateway
# services all use this exact version.
OMP_VERSION=18.12.2
# Optional extra CLIs baked into the Agent image when building it locally.
AGENT_CLIS=

# --- Console --------------------------------------------------------------
# Public console origin used for cookies and the GitHub App redirect.
PUBLIC_ORIGIN=http://localhost:8180
LISTEN_HOST=127.0.0.1
HTTP_PORT=8180
SECURE_COOKIES=false

# --- Forager Cells --------------------------------------------------------
# Set by compose.cells.yaml, which also mounts the Docker socket and makes
# DATA_DIR writable. Keep 0 in the base stack.
SWARMJET_CELLS=0
SWARMJET_DEFAULT_MODEL=deepseek/deepseek-chat
SWARMJET_CELL_MCP_URL=http://swarmjet:8080/mcp
# Empty derives http://swarmjet:8080/llm from SWARMJET_CELL_MCP_URL.
SWARMJET_CELL_LLM_URL=
# Empty means <COMPOSE_PROJECT_NAME>_default.
SWARMJET_CELL_NETWORK=

# --- Model credentials ----------------------------------------------------
# There is no free default model. Add a DeepSeek API key from the console
# (Models page) or through the admin-only set_model_credential MCP tool before
# starting Cells. The key is stored in the omp auth broker, never in a Cell.
# compose.cells.yaml fills these in by default; keep them empty here.
# The broker and gateway publish no host ports and are reachable only on the
# Compose network. Their token files live under DATA_DIR/omp (mode 0600).
SWARMJET_LLM_GATEWAY_URL=
SWARMJET_AUTH_BROKER_URL=

# --- GitHub App (optional manual fallback) --------------------------------
# Prefer the console "setup" page, which stores these encrypted in the
# database. Environment values take precedence when present.
GITHUB_APP_ID=
# Container-visible path; keep the PEM under DATA_DIR, e.g.
# /srv/swarmjet/data/github-app-key.pem.
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=

# --- Webhook tunnel (optional) --------------------------------------------
# deploy/install.py sets this to http://tunnel:2000 when the tunnel profile
# is enabled. It must stay empty when the tunnel is not running.
SWARMJET_TUNNEL_URL=
TUNNEL_METRICS_PORT=2000

# --- Observability profile (optional) ------------------------------------
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
